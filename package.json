{
  "name": "ttrpg-app",
  "productName": "Smart Charsheet",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:engine": "tsc -p tsconfig.engine.json",
    "build:renderer": "webpack",
    "build": "rm -rf dist && npm run build:main && npm run build:engine && npm run build:renderer",
    "start": "npm run build && npx electron dist/main/main.js",
    "dist": "npm run build && electron-builder",
    "package:mac":    "npm run build && electron-builder --mac",
    "package:win":    "npm run build && electron-builder --win",
    "package:linux":  "npm run build && electron-builder --linux",
    "package:all":    "npm run build && electron-builder --mac --win --linux"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "electron": "^41.5.0",
    "mathjs": "^15.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron-builder": "^26.8.1",
    "electron-icon-maker": "^0.0.5",
    "electron-rebuild": "^3.2.9",
    "html-webpack-plugin": "^5.6.7",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack": "^5.106.2",
    "webpack-cli": "^7.0.2"
  },
  "build": {
    "appId": "com.junkiebebra.smartcharsheet",
    "productName": "Smart Charsheet",
    "publish": {
      "provider": "github"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "data/**/*"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "target": ["dmg", "zip"]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis"]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": ["AppImage"]
    }
  }
}
